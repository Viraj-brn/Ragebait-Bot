# ============================================================
# Ragebait Bot — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# ============================================================

# --- Groq API (if using Groq for inference) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Supabase Postgres Database ---
# Get these from: Supabase Dashboard > Project Settings > Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_supabase_db_password
POSTGRES_DB=postgres
POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_PORT=5432

# --- Clerk Authentication ---
# Get these from: Clerk Dashboard > API Keys
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# --- Concurrency Settings ---
# Max simultaneous LLM requests (protect GPU from OOM)
MAX_CONCURRENT_REQUESTS=2

# --- Hugging Face Token ---
# Get this from: Hugging Face Settings > Access Tokens
HF_TOKEN=your_huggingface_token_here
